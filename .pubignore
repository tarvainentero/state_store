# Note: when .pubignore exists, pub uses it INSTEAD of .gitignore for this
# directory, so the relevant .gitignore rules are repeated here.

# Not part of the published library
state_store_debugger/
docs/
.claude/
test/

# Lock files and tool output
pubspec.lock
example/pubspec.lock
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
**/doc/api/

# Example app platform folders (keep example/lib and example/pubspec.yaml)
example/android/
example/ios/
example/macos/
example/linux/
example/windows/
example/web/
example/build/
example/.dart_tool/
example/test/

# Editor and OS noise
.idea/
*.iml
*.ipr
*.iws
.DS_Store
*.log
*.swp
.history
.atom/
.buildlog/
.svn/
migrate_working_dir/
